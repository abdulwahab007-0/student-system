# ============================================================================
# Environment config — copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================================

# Port for the local API server
PORT=3001

# JWT signing secret (keep it secret in production!)
JWT_SECRET=ncba-e-sms-dev-secret-2026

# ── Supabase (PostgreSQL) backend ───────────────────────────────────────────
# Set SUPABASE_DB_URL to use Supabase. When it is absent/empty, the local
# SQLite backend (database.sqlite) is used automatically, so local dev needs
# no configuration. DATABASE_URL is an accepted alias for the same value.
#
# How to get this value:
#   Supabase Dashboard → your project → Project Settings → Database →
#   "Connection string" → "Connection pooling"
#
# Two pool modes are available (port differs):
#
#   SESSION pooler  → port 5432  (recommended for long-lived servers & local dev)
#     postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   TRANSACTION pooler → port 6543  (RECOMMENDED for Vercel/serverless)
#     postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
#   ⚠️ On Vercel (serverless) PREFER the TRANSACTION pooler (:6543). The session
#   pooler caps the whole project at 15 concurrent backends; every serverless
#   cold start creates a fresh pg pool, and several cold starts at once can
#   exhaust the session cap (→ EMAXCONNSESSION). The transaction pooler handles
#   many more concurrent connections because it does not pin one TCP backend per
#   session, which avoids cold-start stalls. node-postgres (`pg`) and this app's
#   `transaction()` helper both work unchanged with the transaction pooler.
#
# (URL-encode special characters in the password.)
SUPABASE_DB_URL=

# Keep SSL on for Supabase's pooler (default true). Set to false only for a
# trusted private/local network direct connection.
SUPABASE_SSL=true

# Set to 1 to auto-apply supabase/schema.sql on server boot (idempotent).
# Otherwise run supabase/schema.sql once in the Supabase SQL Editor.
SUPABASE_AUTO_MIGRATE=1

# Timezone used for lecture-time window enforcement (attendance marking).
# Schedule period times (e.g. "08:00 - 09:30") are interpreted in this IANA
# timezone. On Vercel the server runs in UTC, so this MUST be set here and in
# the Vercel project settings, otherwise attendance would be blocked ~5h early/late.
SCHEDULE_TIMEZONE=Asia/Karachi